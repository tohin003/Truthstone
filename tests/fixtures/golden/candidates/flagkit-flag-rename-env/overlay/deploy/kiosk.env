# Environment of the in-store kiosk app (shop floor tablets), applied by the deploy pipeline.
# FLAGKIT_* variables override flags in flags/mobile.json: see "Environment overrides" in the README.
KIOSK_MODE=1
MOBILE_FLAGS=flags/mobile.json
# Kiosks are shared tablets with no logged-in plan, and staff reorder for customers all day:
# the reorder button is always on there.
FLAGKIT_ONE_TAP_REORDER=on
