{
  "description": "AgentGuard: evidence checks, risk and scope review, and a completion gate. Session and prompt hooks run scripts/hook.sh, which installs the AgentGuard runtime on first use; per-tool hooks exec that runtime's lean forwarder directly, and do nothing until it exists.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\" session-start",
            "timeout": 300,
            "statusMessage": "AgentGuard: starting (the first session installs its runtime)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\" prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_DATA}/runtime/bin/python\"; [ -x \"$p\" ] || exit 0; exec \"$p\" -I -S \"${CLAUDE_PLUGIN_DATA}/forward.py\" --timeout 4",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_DATA}/runtime/bin/python\"; [ -x \"$p\" ] || exit 0; exec \"$p\" -I -S \"${CLAUDE_PLUGIN_DATA}/forward.py\" --timeout 4",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_DATA}/runtime/bin/python\"; [ -x \"$p\" ] || exit 0; exec \"$p\" -I -S \"${CLAUDE_PLUGIN_DATA}/forward.py\" --timeout 4",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_DATA}/runtime/bin/python\"; [ -x \"$p\" ] || exit 0; exec \"$p\" -I -S \"${CLAUDE_PLUGIN_DATA}/forward.py\" --timeout 9",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_DATA}/runtime/bin/python\"; [ -x \"$p\" ] || exit 0; exec \"$p\" -I -S \"${CLAUDE_PLUGIN_DATA}/forward.py\" --timeout 1",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
